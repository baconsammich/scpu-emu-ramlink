+/* --- SCPUTRACE: cartridge I/O log, PC-tagged, capped --- */
+static void scputrace_cart(int write, uint16_t addr, uint8_t value)
+{
+    extern unsigned int reg_pc;
+    static unsigned long n = 0;
+    if (++n <= 400)
+        log_message(LOG_DEFAULT, "SCPUTRACE CART %c $%04x = %02x  pc=$%04x",
+                    write ? 'W' : 'R', addr, value, reg_pc);
+    if (write && addr == 0xde39) {
+        static int once = 0;
+        if (!once) {
+            char b[256]; int k, bi = 0;
+            once = 1;
+            for (k = 0; k < 32; k++)
+                bi += snprintf(b + bi, sizeof(b) - bi, " %02x", mem_sram[0x10000 + 0x4ed0 + k]);
+            log_message(LOG_DEFAULT, "SCPUTRACE BANK1 $4ED0:%s", b);
+            bi = 0;
+            for (k = 0; k < 32; k++)
+                bi += snprintf(b + bi, sizeof(b) - bi, " %02x", mem_sram[0x4ed0 + k]);
+            log_message(LOG_DEFAULT, "SCPUTRACE BANK0 $4ED0:%s", b);
+            log_message(LOG_DEFAULT, "SCPUTRACE cfg=$%02x dosext=%d hwen=%d boot=%d",
+                        mem_config, mem_reg_dosext, mem_reg_hwenable, mem_reg_bootmap);
+        }
+    }
+}
